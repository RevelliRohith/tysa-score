# TYSA Score Environment Configuration Template
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Database
# If DATABASE_URL is set, PostgreSQL is used (e.g. postgres://user:password@localhost:5432/tysa_db).
# If unset, defaults to local SQLite development database (db.sqlite3).
DATABASE_URL=

# Realtime & Caching (Redis / ASGI Channels)
REDIS_URL=redis://127.0.0.1:6379/0

# Celery Background Workers
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_ALWAYS_EAGER=True
