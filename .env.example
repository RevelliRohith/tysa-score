# TYSA Score Environment Configuration Template
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.29.153

# Database: Neon PostgreSQL Configuration
# For Migrations & Testing, use the direct endpoint (no -pooler):
# DATABASE_URL=postgresql://neondb_owner:[PASSWORD]@[EP_ID].us-east-2.aws.neon.tech/neondb?sslmode=require
#
# For High-Concurrency Production Web Serving, use the pooled endpoint (-pooler):
# DATABASE_URL=postgresql://neondb_owner:[PASSWORD]@[EP_ID]-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# DB_CONN_MAX_AGE=0
DATABASE_URL=

# Realtime & Caching (Redis / ASGI Channels)
REDIS_URL=redis://127.0.0.1:6379/0

# Celery Background Workers
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_ALWAYS_EAGER=True
